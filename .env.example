DATABASE_URL=postgresql://peng:peng@localhost:5432/peng_opa
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5180
# Dev (pnpm dev): the Vite URL above. Production (pnpm start): the URL the Node server is reached at, e.g. http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPA_PORT=8181
# OPA_URL=  # set only to use an external OPA instead of the bundled one
OPA_TOKEN=change-me
RATE_LIMIT_RPS=50
DEMO_PUBLIC=false
SMTP_URL=
# Tests: a database the test run may create and drop schemas in
TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/peng_opa_test
# TEST_OPA_URL=  # optional: external OPA for tests
# TEST_OPA_TOKEN=change-me

# Local dev/test account used when checking the UI (local database only):
# DEV_TEST_EMAIL=dev@peng-opa.test
# DEV_TEST_PASSWORD=dev-password-123
