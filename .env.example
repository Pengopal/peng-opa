DATABASE_URL=postgresql://peng:peng@localhost:5432/peng_opa
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5180
# Dev (pnpm dev): the Vite URL above. Production (pnpm start): the URL the Node server is reached at, e.g. http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPA_PORT=8181
# OPA_URL=  # set only to use an external OPA instead of the bundled one
OPA_TOKEN=change-me
RATE_LIMIT_RPS=50
DEMO_PUBLIC=false
# Invite emails: Resend (preferred; Railway blocks outbound SMTP on most plans) or SMTP. Neither: links are shown to copy.
RESEND_API_KEY=
MAIL_FROM=  # e.g. peng-opa <no-reply@pengopal.com>, on a domain verified in Resend
SMTP_URL=
# Product analytics (optional): a PostHog project key (phc_…). Unset: no analytics. EU cloud unless POSTHOG_HOST is set.
POSTHOG_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# Sign in with Tenantry (optional; all three or none). Local Tenantry stack shown; production uses
# https://auth.tenantry.pengopal.com/realms/platform and the secret from Tenantry's operator.
TENANTRY_ISSUER=
TENANTRY_CLIENT_ID=
TENANTRY_CLIENT_SECRET=
# TENANTRY_ISSUER=http://auth.tenantry.localhost/realms/platform
# TENANTRY_CLIENT_ID=pengopa
# TENANTRY_CLIENT_SECRET=dev-pengopa-secret
# Only where this server cannot resolve the issuer's host (local *.localhost): Keycloak's direct address.
# TENANTRY_INTERNAL_URL=http://127.0.0.1:8180
# Tests: a database the test run may create and drop schemas in
TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/peng_opa_test
# TEST_OPA_URL=  # optional: external OPA for tests
# TEST_OPA_TOKEN=change-me

# Local dev/test account used when checking the UI (local database only):
# DEV_TEST_EMAIL=dev@peng-opa.test
# DEV_TEST_PASSWORD=dev-password-123
